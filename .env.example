# Optional. With no key set, ArchiMind uses its deterministic brief parser and
# local design reviewer, and every other feature works unchanged.
# Set ONE of the following.

# Google Gemini (free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI or any OpenAI-compatible endpoint
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Server
HOST=127.0.0.1
PORT=8000
